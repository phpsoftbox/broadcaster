{
    "name": "phpsoftbox/broadcaster",
    "description": "Broadcaster component for the PhpSoftBox framework (Pushr)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/config": "^1.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "^1.0",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Broadcaster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Broadcaster\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "phpsoftbox/cli-app": "Required for pushr:* commands (server, signatures, channel auth)."
    },
    "extra": {
        "psb": {
            "providers": [
                "PhpSoftBox\\Broadcaster\\Cli\\PushrCommandProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
